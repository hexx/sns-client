{
  "name": "super-sns-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-icons.mjs && vite build app",
    "dev:app": "vite app",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "lint": "oxlint app/src shared worker/src scripts --deny-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@atproto/api": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^3.100.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
