{
  "name": "super-sns-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-icons.mjs && vite build app",
    "dev:app": "vite app",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atproto/api": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.75.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^3.100.0"
  }
}
