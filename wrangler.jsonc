{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sns-client",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "MISSKEY_INSTANCE_URL": "https://misskey.io"
  },
  // カスタム View 定義の保存先（docs/deck-view-spec.md §3）。
  // id は `npx wrangler kv namespace create VIEWS` の出力で置き換えること（ローカル dev はエミュレーションで動作）。
  "kv_namespaces": [
    { "binding": "VIEWS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
  // シークレットは `wrangler secret put` で設定:
  //   BSKY_HANDLE, BSKY_APP_PASSWORD, MISSKEY_TOKEN
}
